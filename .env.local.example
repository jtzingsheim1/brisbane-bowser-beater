# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — secrets never go into version control.

# ─────────────────────────────────────────────────────────────────────────────
# Supabase (Phase 1)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of your Supabase project (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=

# Anon key — safe to expose to the browser; RLS policies enforce access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key (formerly service_role) — SERVER-ONLY. Bypasses RLS.
# Used by the daily cron job to write into `forecasts` and price tables.
# NEVER expose to the browser and NEVER log this value.
SUPABASE_SERVICE_ROLE_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# QLD Fuel Price Reporting API (Phase 2)
# Register as a publisher at https://www.fuelpricesqld.com.au
# ("Publisher" = an app that displays fuel prices to motorists, per QLD's
# own definition.) Accept the publisher licence; the security token arrives
# by email. Sent as a header: Authorization: FPDAPI SubscriberToken=<token>
# ─────────────────────────────────────────────────────────────────────────────
QLD_FUEL_API_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# Anthropic Claude API (Phase 4)
# Get from: https://console.anthropic.com/settings/keys
# Set a hard spend cap in the Anthropic console before deploying.
# ─────────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Cron protection (Phase 5)
# Random secret used by the Vercel Cron endpoint to reject unauthenticated hits.
# Generate with: `openssl rand -hex 32`
# ─────────────────────────────────────────────────────────────────────────────
# CRON_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# Upstash Redis for rate limiting (Phase 5)
# Provisioned via the Vercel Marketplace (free tier).
# ─────────────────────────────────────────────────────────────────────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# Operational kill switch (Phase 5)
# Public visibility toggle. When unset, empty, "false", or "0", the whole
# site renders the maintenance page instead of any licence-bound display.
# Set to "true" (or "1") to make the site public. Read per-request, so
# flipping it in the Vercel dashboard takes effect on the next request —
# no redeploy needed. This is the manual half of the off-switch; the
# automatic half is the staleness check in src/lib/freshness.ts.
# ─────────────────────────────────────────────────────────────────────────────
# BBB_PUBLIC=true
