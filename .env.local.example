# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — secrets never go into version control.
#
# Scope: this file is for LOCAL development only. It feeds (a) the Next.js dev
# server and (b) the helper scripts in package.json that load it via
# `--env-file=.env.local`. PRODUCTION env vars are set in the Vercel dashboard —
# see docs/deploy-runbook.md for that list. A few vars are production-only and
# do nothing locally; they're noted at the bottom rather than listed as settable.

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — required for local dev (the app reads aggregates; scripts write)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (service_role) — SERVER / SCRIPTS ONLY. Bypasses RLS. Never expose
# to the browser, never log this value.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Public visibility — required locally
# When unset, empty, "false", or "0", the WHOLE site renders the maintenance
# page, so you must set this to "true" to see the app in local dev. (In
# production this is the manual kill switch, flipped from the Vercel dashboard.)
# ─────────────────────────────────────────────────────────────────────────────
BBB_PUBLIC=true

# ─────────────────────────────────────────────────────────────────────────────
# Anthropic Claude API — optional locally (needed to exercise the agent)
# Get from: https://console.anthropic.com/settings/keys — set a hard spend cap.
# Without it the agent route returns 503; the rest of the page renders fine.
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Stripe tip jar ("Shout me a litre") — optional locally
# The tip jar is OFF unless BBB_TIPS=true, so with none of these set the site
# simply has no payment UI. To exercise it locally: use TEST-mode keys from
# https://dashboard.stripe.com/test/apikeys (a restricted key with Checkout
# Session write is enough), and get a webhook signing secret from
# `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# LIVE keys are set in the Vercel dashboard only — never in this file.
# ─────────────────────────────────────────────────────────────────────────────
BBB_TIPS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: canonical site origin (e.g. https://your-site.vercel.app) used to
# build the post-checkout redirect URLs. When set, it's used instead of the
# request's Host header, so a forged Host can't influence the redirect. Leave
# unset locally (falls back to the request host).
APP_ORIGIN=

# ─────────────────────────────────────────────────────────────────────────────
# QLD Fuel Price Reporting API — only for local data scripts (optional)
# Needed solely if you manually run `npm run ingest:prices` / `refresh:sites`.
# In production these run in GitHub Actions (repo secret) and never on Vercel,
# so this token never goes in the Vercel dashboard.
# Register as a publisher at https://www.fuelpricesqld.com.au
# ─────────────────────────────────────────────────────────────────────────────
QLD_FUEL_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Production-only — DO NOT set these locally (they are no-ops in dev).
# Configure them in Vercel; see docs/deploy-runbook.md. Listed here only so the
# full surface is discoverable:
#   • CRON_SECRET   — locks /api/cron/forecast (the route is open when unset)
#   • USAGE_SALT    — enables anonymous LUL 4.8 visitor counting (off when unset)
#   • BBB_STALENESS_MINUTES — optional staleness-gate override (default 60); raise
#                     to ride out cron lag, since the chart is a daily aggregate
#   • Rate limiting — provisioned via the Vercel Upstash Marketplace integration,
#                     which auto-injects KV_REST_API_URL / KV_REST_API_TOKEN
#                     (the limiter reads those). Nothing to set by hand.
# ─────────────────────────────────────────────────────────────────────────────
