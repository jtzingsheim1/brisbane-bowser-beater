# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
/.next/
/out/
next-env.d.ts

# Production builds
/build
dist/

# Testing
/coverage

# Local env files (NEVER commit secrets)
# Specific patterns (NOT .env* — that would also block the .env.local.example template)
.env
.env.local
.env.*.local

# Vercel
.vercel

# TypeScript
*.tsbuildinfo

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# OS
.DS_Store
Thumbs.db
*.pem

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code local state (settings, hooks, session config)
.claude/

# Python (for /analysis Jupyter notebooks)
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.venv/
venv/
.python-version

# Project-specific
