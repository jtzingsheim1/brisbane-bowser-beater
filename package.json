{
  "name": "brisbane-bowser-beater",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "verify:supabase": "node --env-file=.env.local scripts/verify-supabase.mjs",
    "backfill:csv": "node --env-file=.env.local scripts/backfill-csv.mjs",
    "ingest:prices": "node --env-file=.env.local scripts/ingest-prices.mjs",
    "refresh:sites": "node --env-file=.env.local scripts/refresh-sites.mjs",
    "forecast:generate": "node --env-file=.env.local --import tsx scripts/generate-forecast.ts",
    "freshness:touch": "node --env-file=.env.local scripts/touch-freshness.mjs --force",
    "dev:fresh": "node --env-file=.env.local scripts/touch-freshness.mjs --force && next dev"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/react": "^3.0.198",
    "@supabase/supabase-js": "^2.107.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "ai": "^6.0.190",
    "next": "16.2.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^6.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^6",
    "vitest": "^4.1.8"
  }
}
